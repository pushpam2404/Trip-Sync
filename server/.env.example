# Copy to server/.env and fill in. Never commit the real file.

# Port the API listens on. Render sets this for you.
PORT=3001

# MongoDB connection string.
#   local: mongodb://localhost:27017/tripsync
#   Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tripsync
MONGO_URI=mongodb://localhost:27017/tripsync

# Secret used to sign login tokens. Required, no default.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Google AI Studio key for the Sakha chat. Leave it empty to run Sakha in demo mode:
# a built-in rule-based responder answers instead, and the UI shows a "Demo mode" badge.
# The key stays on the server; the browser never sees it.
GEMINI_API_KEY=

# Optional. Model used by Sakha. gemini-2.5-flash is on Google's free tier.
GEMINI_MODEL=gemini-2.5-flash

NODE_ENV=development
