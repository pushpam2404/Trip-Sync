# Copy to client/.env.local. Vite only exposes variables that start with VITE_.

# REQUIRED. Base URL of the TripSync API. There is no fallback: without it the app shows
# a configuration screen instead of loading. It is read at build time, so rebuild after changing it.
VITE_API_URL=http://localhost:3001/api

# Mappls (MapmyIndia) map SDK key: draws the map on the navigation screen. It ends up
# in the browser bundle by design, so restrict it to your domains in the Mappls console.
# Place search, geocoding and directions need no key: they use OpenStreetMap services.
VITE_MAPPLS_MAP_SDK_KEY=
